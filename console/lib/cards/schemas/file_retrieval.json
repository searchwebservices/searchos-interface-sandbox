{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "file_retrieval",
  "description": "Files the agent found. path is repo relative and must sit under book/, docs/, registry/ or console/data/uploads/ to be downloadable.",
  "type": "object",
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "kind", "size", "lane"],
        "properties": {
          "id": { "type": "string", "maxLength": 64, "description": "The Library row id (docs/library-spec.md); download and preview then go through /api/library/:id." },
          "name": { "type": "string", "maxLength": 200 },
          "path": { "type": "string", "maxLength": 1000 },
          "kind": { "type": "string", "maxLength": 40 },
          "size": { "type": "integer" },
          "lane": { "type": "string", "maxLength": 80 },
          "hash": { "type": "string", "maxLength": 128 },
          "summary": { "type": "string", "maxLength": 2000 }
        }
      }
    }
  }
}
