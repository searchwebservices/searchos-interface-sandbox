{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "approval",
  "description": "Permission to act. The ask item of console/lib/events.js buildAsk. scope says where the command runs, its class, and whether the console policy lets the Always button show for it.",
  "type": "object",
  "required": ["request_id", "action"],
  "properties": {
    "request_id": { "type": "string", "maxLength": 200 },
    "action": { "type": "string", "maxLength": 400 },
    "resources": { "type": "array", "items": { "type": "string", "maxLength": 1000 } },
    "message": { "type": "string", "maxLength": 4000 },
    "scope": {
      "type": "object",
      "required": ["command_class", "always_allowed"],
      "properties": {
        "host": { "type": "string", "maxLength": 200 },
        "command_class": { "type": "string", "maxLength": 40 },
        "always_allowed": { "type": "boolean" }
      }
    },
    "device": { "type": "string", "maxLength": 120 }
  }
}
