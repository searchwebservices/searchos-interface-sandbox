{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "config_diff",
  "description": "A proposed change, before and after. For the changes item, target names the files and unified holds the diff.",
  "type": "object",
  "required": ["target", "before", "after"],
  "properties": {
    "target": { "type": "string", "maxLength": 500 },
    "before": { "type": "string", "maxLength": 100000 },
    "after": { "type": "string", "maxLength": 100000 },
    "unified": { "type": "string", "maxLength": 100000 },
    "reason": { "type": "string", "maxLength": 2000 }
  }
}
