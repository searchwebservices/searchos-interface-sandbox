{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "requested_input",
  "description": "Questions for a person. The form item of console/lib/forms.js buildForm.",
  "type": "object",
  "required": ["id", "title", "fields"],
  "properties": {
    "id": { "type": "string", "maxLength": 200 },
    "title": { "type": "string", "maxLength": 300 },
    "fields": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["key", "type"], "properties": { "key": { "type": "string", "maxLength": 100 }, "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "multiselect", "external"] }, "title": { "type": "string", "maxLength": 400 } } } },
    "metadata": { "type": ["object", "null"] }
  }
}
