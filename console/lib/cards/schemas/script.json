{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "script",
  "description": "A script Gilfoyle proposes. Informational unless executable is true. Surface: Script Runner. An executable script must list the permissions it needs.",
  "type": "object",
  "required": ["target", "cwd", "language", "code", "executable", "permissions"],
  "properties": {
    "target": { "type": "string", "maxLength": 200 },
    "cwd": { "type": "string", "maxLength": 1000 },
    "language": { "type": "string", "maxLength": 40 },
    "code": { "type": "string", "maxLength": 20000 },
    "executable": { "type": "boolean" },
    "permissions": { "type": "array", "items": { "type": "string", "maxLength": 200 } }
  }
}
